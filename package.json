{
  "name": "car-rental-3d",
  "version": "1.0.0",
  "description": "Full-stack Car Rental web app with live interactive 3D vehicle inspection, customer booking, and admin fleet management.",
  "private": true,
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "build": "cd client && npm install --include=dev && npm run build && cd ../server && npm install",
    "start": "node server/index.js",
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "car-rental",
    "3d",
    "threejs",
    "react",
    "express",
    "fleet-management"
  ],
  "author": "",
  "license": "MIT"
}
